prefix=/home/codeflow/ffmpeg/install
exec_prefix=${prefix}
libdir=/home/codeflow/ffmpeg/install/lib
includedir=/home/codeflow/ffmpeg/install/include

Name: libavformat-aac
Description: FFmpeg container format library
Version: 63.1.102
Requires: 
Requires.private: libavcodec-aac >= 63.1.102, libavutil-aac >= 61.1.102
Conflicts:
Libs: -L${libdir}  -lavformat-aac 
Libs.private: -lm -latomic -lz
Cflags: -I${includedir}
